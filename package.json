{
	"name": "iris",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"postinstall": "latitude-skills",
		"ds:update": "npm pack \"/Users/vitalii/Development/design-system-test/packages/design-system\" --pack-destination .latitude && pnpm add @latitudelabs/design-system@file:.latitude/latitudelabs-design-system-0.0.1.tgz",
		"deploy": "pnpm build && wrangler deploy",
		"db:migrate": "wrangler d1 migrations apply iris --remote",
		"db:seed": "node scripts/d1-seed.mjs > .wrangler/seed.sql && wrangler d1 execute iris --remote --file .wrangler/seed.sql",
		"storybook": "storybook dev -p 6007 --no-open",
		"build-storybook": "storybook build -o storybook-static",
		"storybook:fixtures": "node scripts/storybook-fixtures.mjs"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.133.0",
		"@latitudelabs/design-system": "file:.latitude/latitudelabs-design-system-0.0.1.tgz",
		"bits-ui": "^2.20.2",
		"dialkit": "^2.0.2",
		"mode-watcher": "^1.1.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@storybook/addon-a11y": "^10.6.2",
		"@storybook/addon-docs": "^10.6.2",
		"@storybook/addon-svelte-csf": "^5.1.5",
		"@storybook/addon-themes": "^10.6.2",
		"@storybook/svelte-vite": "^10.6.2",
		"@sveltejs/adapter-cloudflare": "8.0.1",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"devalue": "^6.0.3",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"marked": "^18.1.1",
		"mermaid": "^12.2.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"storybook": "^10.6.2",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"wrangler": "4.151.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
